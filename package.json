{
  "name": "thefactory_frontend_task",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vue-tsc && vp build",
    "preview": "vp preview",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "prepare": "simple-git-hooks",
    "lint-staged": "lint-staged",
    "generate-pwa-assets": "pwa-assets-generator",
    "story:dev": "histoire dev",
    "story:build": "histoire build",
    "story:preview": "histoire preview",
    "upgrade": "npx npm-check-updates -u && npm install",
    "visualize": "npx vite-bundle-visualizer",
    "test:unit": "vp test",
    "test:e2e": "playwright test",
    "coverage": "vp test run --coverage"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.0",
    "@vueuse/router": "^14.2.0",
    "blurhash": "^2.0.5",
    "ditox": "^3.1.0",
    "focus-trap": "^8.0.0",
    "magic-grid": "^3.4.7",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "quick-lru": "^7.3.0",
    "vue": "^3.5.27",
    "vue-router": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@histoire/plugin-vue": "^1.0.0-beta.1",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.58.1",
    "@types/node": "^25.1.0",
    "@types/nprogress": "^0.2.3",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "dotenv": "^17.2.3",
    "eslint-plugin-format": "^2.0.1",
    "happy-dom": "^20.4.0",
    "histoire": "^1.0.0-beta.1",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "postcss-html": "^1.8.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^7.0.2",
    "unplugin-icons": "^23.0.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vite-plugin-webfont-dl": "^3.11.1",
    "vite-plus": "latest",
    "vue-tsc": "^3.2.4"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint-staged"
  },
  "lint-staged": {
    "*": "vp lint --fix"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "packageManager": "npm@11.8.0"
}
